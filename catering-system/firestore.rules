rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── 共用函式 ──────────────────────────────────────────────────────────────

    // 是否已登入
    function isAuthenticated() {
      return request.auth != null;
    }

    // 是否為採購人員（透過 Firebase Auth Custom Claims 設定）
    // 設定方式：Admin SDK → auth.setCustomUserClaims(uid, { role: 'purchasing' })
    function isPurchasingStaff() {
      return isAuthenticated() && request.auth.token.role == 'purchasing';
    }

    // ── ingredients 共用驗證 ─────────────────────────────────────────────────
    // 共同欄位型別/值檢查（create 與 update 皆適用）
    function validIngredientCommon(data) {
      return data.name is string && data.name.size() > 0
        && data.normalizedName is string && data.normalizedName.size() > 0
        && data.baseUnit in ['g', 'ml', 'pcs']
        && data.conversionFactorToBaseUnit is number && data.conversionFactorToBaseUnit > 0
        && data.isActive is bool
        && (!('supplierId' in data) || data.supplierId == null || data.supplierId is string)
        && (!('marketCropName' in data) || data.marketCropName == null || data.marketCropName is string);
    }

    // 允許寫入的完整欄位白名單：包含 Feature 010 新欄位，以及既有功能
    // （seedIngredients.ts / recipeMatchingService.ts / aiContextService.ts）
    // 仍在使用的舊欄位，避免破壞現有流程。
    function ingredientAllowedFields() {
      return [
        'id', 'name', 'normalizedName', 'category',
        'unit', 'unitCost', 'minStockLevel', 'supplierIds',
        'baseUnit', 'purchaseUnit', 'conversionFactorToBaseUnit',
        'defaultPrice', 'defaultPriceUnit', 'supplierId',
        'isActive', 'notes', 'wasteFactor', 'isOcr', 'verified',
        'marketCropName',
        'createdAt', 'updatedAt', 'createdBy', 'updatedBy',
      ];
    }

    function validIngredientCreate() {
      let data = request.resource.data;
      return validIngredientCommon(data)
        && data.keys().hasOnly(ingredientAllowedFields())
        && data.createdAt is timestamp
        && data.createdBy is string
        && data.updatedAt is timestamp
        && data.updatedBy is string;
    }

    function validIngredientUpdate() {
      let data = request.resource.data;
      // createdAt/createdBy: 不可變更；但舊資料（Feature 010 之前建立）可能
      // 沒有這兩個欄位，允許在編輯時回填一次（updateIngredient 會保留既有值）。
      return validIngredientCommon(data)
        && data.keys().hasOnly(ingredientAllowedFields())
        && data.updatedAt is timestamp
        && data.updatedBy is string
        && (!('createdAt' in resource.data) || data.createdAt == resource.data.createdAt)
        && (!('createdBy' in resource.data) || data.createdBy == resource.data.createdBy)
        && data.createdAt is timestamp
        && data.createdBy is string;
    }

    // ── orders ────────────────────────────────────────────────────────────────
    // 允許讀取與新增；明確禁止刪除；更新需已登入
    match /orders/{orderId} {
      allow read:   if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if false; // 訂單不可刪除，只能取消 (status: 'cancelled')
    }

    // ── inventory ─────────────────────────────────────────────────────────────
    // 主文件：已登入可讀寫
    match /inventory/{ingredientId} {
      allow read:  if isAuthenticated();
      allow write: if isAuthenticated();

      // 異動紀錄子集合：只允許新增（不可修改/刪除，保持稽核完整性）
      match /transactions/{txId} {
        allow read:   if isAuthenticated();
        allow create: if isAuthenticated();
        allow update: if false;
        allow delete: if false;
      }
    }

    // ── purchases ─────────────────────────────────────────────────────────────
    // 讀取限採購人員；寫入（新增/更新）需已登入；禁止刪除
    match /purchases/{purchaseId} {
      allow read:   if isPurchasingStaff();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if false;
    }

    // ── menus ─────────────────────────────────────────────────────────────────
    // 採購計算需要讀取菜單 BOM，已登入皆可讀；寫入需採購人員
    match /menus/{menuId} {
      allow read:  if isAuthenticated();
      allow write: if isPurchasingStaff();
    }

    // ── ingredients ───────────────────────────────────────────────────────────
    // 食材主檔：已登入可讀；寫入需採購人員
    match /ingredients/{ingredientId} {
      allow read: if isAuthenticated();
      allow create: if isPurchasingStaff() && validIngredientCreate();
      allow update: if isPurchasingStaff() && validIngredientUpdate();
      allow delete: if false;
    }

    // ── recipes ───────────────────────────────────────────────────────────────
    // 配方：引用 /ingredients 食材主檔。已登入可讀；寫入需採購人員。
    // 注意：每個 recipeIngredients 項目的詳細驗證（unit 是否符合食材的
    // baseUnit/purchaseUnit、ingredient 是否啟用等）由 recipeService.ts 在
    // 寫入前負責，Firestore Rules 不對 list 內每個項目做逐筆型別檢查。
    function validRecipeCommon(data) {
      return data.name is string && data.name.size() > 0
        && data.recipeIngredients is list
        && data.isActive is bool;
    }

    function validRecipeCreate() {
      return validRecipeCommon(request.resource.data)
        && request.resource.data.keys().hasOnly(['name', 'recipeIngredients', 'isActive', 'notes', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && request.resource.data.createdAt is timestamp && request.resource.data.createdBy is string
        && request.resource.data.updatedAt is timestamp && request.resource.data.updatedBy is string;
    }

    function validRecipeUpdate() {
      return validRecipeCommon(request.resource.data)
        && request.resource.data.keys().hasOnly(['name', 'recipeIngredients', 'isActive', 'notes', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && request.resource.data.updatedAt is timestamp && request.resource.data.updatedBy is string
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy;
    }

    match /recipes/{recipeId} {
      allow read: if isAuthenticated();
      allow create: if isPurchasingStaff() && validRecipeCreate();
      allow update: if isPurchasingStaff() && validRecipeUpdate();
      allow delete: if false;
    }

    // ── recipeMenus ───────────────────────────────────────────────────────────
    // 菜單：引用 /recipes 配方。已登入可讀；寫入需採購人員。
    // 注意：每個 menuRecipes 項目的詳細驗證（recipe 是否存在/啟用、
    // servings 是否 > 0 等）由 recipeMenuService.ts 在寫入前負責，
    // Firestore Rules 不對 list 內每個項目做逐筆型別檢查。
    function validRecipeMenuCommon(data) {
      return data.name is string && data.name.size() > 0
        && data.date is string && data.date.size() > 0
        && data.mealType is string && data.mealType.size() > 0
        && data.menuRecipes is list
        && data.isActive is bool;
    }

    // Feature 022: optional conversion-tracking fields, present only when a
    // recipeMenu was created via manual approval of a menuDraft.
    function validRecipeMenuConversionFields(data) {
      return !('sourceMenuDraftId' in data) || (
        data.sourceMenuDraftId is string && data.sourceMenuDraftId.size() > 0
        && data.sourceMenuDraftSnapshot is map
        && data.manualApprovalAcknowledgement == true
      );
    }

    // Feature 028: optional finalization-tracking fields, present only when a
    // recipeMenu was created via batch finalization of a menuImportBatch.
    function validRecipeMenuImportFinalizeFields(data) {
      return !('sourceMenuImportBatchId' in data) || (
        data.sourceMenuImportBatchId is string && data.sourceMenuImportBatchId.size() > 0
        && data.sourceMenuImportBatchSnapshot is map
      );
    }

    function validRecipeMenuCreate() {
      return validRecipeMenuCommon(request.resource.data)
        && request.resource.data.keys().hasOnly(['name', 'date', 'mealType', 'menuRecipes', 'isActive', 'notes', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'sourceMenuDraftId', 'sourceMenuDraftSnapshot', 'manualApprovalAcknowledgement', 'sourceMenuImportBatchId', 'sourceMenuImportBatchSnapshot'])
        && request.resource.data.createdAt is timestamp && request.resource.data.createdBy is string
        && request.resource.data.updatedAt is timestamp && request.resource.data.updatedBy is string
        && validRecipeMenuConversionFields(request.resource.data)
        && validRecipeMenuImportFinalizeFields(request.resource.data);
    }

    function validRecipeMenuUpdate() {
      return validRecipeMenuCommon(request.resource.data)
        && request.resource.data.keys().hasOnly(['name', 'date', 'mealType', 'menuRecipes', 'isActive', 'notes', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'sourceMenuDraftId', 'sourceMenuDraftSnapshot', 'manualApprovalAcknowledgement', 'sourceMenuImportBatchId', 'sourceMenuImportBatchSnapshot'])
        && request.resource.data.updatedAt is timestamp && request.resource.data.updatedBy is string
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && validRecipeMenuConversionFields(request.resource.data)
        && validRecipeMenuImportFinalizeFields(request.resource.data);
    }

    match /recipeMenus/{menuId} {
      allow read: if isAuthenticated();
      allow create: if isPurchasingStaff() && validRecipeMenuCreate();
      // Feature 022: once a recipeMenu has been created via draft conversion
      // (sourceMenuDraftId set), it becomes immutable — no further update is
      // permitted. This blocks duplicate/race conversion attempts: a second
      // setDoc to recipeMenus/{draftId} is classified as an update (since the
      // doc already exists) and is rejected here.
      allow update: if isPurchasingStaff() && validRecipeMenuUpdate() && !('sourceMenuDraftId' in resource.data);
      allow delete: if false;
    }

    // ── prepPlans ────────────────────────────────────────────────────────────
    // 備料快照：由 /recipeMenus 衍生的備料規劃。已登入可讀；寫入需採購人員。
    // prepItems 由 prepPlanService.ts 在建立時計算並寫入，之後不可變更；
    // sourceRecipeMenuId 同樣不可變更。
    function validPrepPlanCommon(data) {
      return data.name is string && data.name.size() > 0
        && data.sourceRecipeMenuId is string && data.sourceRecipeMenuId.size() > 0
        && data.sourceRecipeMenuNameSnapshot is string
        && data.date is string && data.date.size() > 0
        && data.prepItems is list
        && data.isActive is bool;
    }

    function validPrepPlanCreate() {
      return validPrepPlanCommon(request.resource.data)
        && request.resource.data.keys().hasOnly(['name', 'sourceRecipeMenuId', 'sourceRecipeMenuNameSnapshot', 'date', 'prepItems', 'isActive', 'notes', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && request.resource.data.createdAt is timestamp && request.resource.data.createdBy is string
        && request.resource.data.updatedAt is timestamp && request.resource.data.updatedBy is string;
    }

    function validPrepPlanUpdate() {
      return validPrepPlanCommon(request.resource.data)
        && request.resource.data.keys().hasOnly(['name', 'sourceRecipeMenuId', 'sourceRecipeMenuNameSnapshot', 'date', 'prepItems', 'isActive', 'notes', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && request.resource.data.updatedAt is timestamp && request.resource.data.updatedBy is string
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.sourceRecipeMenuId == resource.data.sourceRecipeMenuId
        && request.resource.data.prepItems == resource.data.prepItems;
    }

    match /prepPlans/{prepPlanId} {
      allow read: if isAuthenticated();
      allow create: if isPurchasingStaff() && validPrepPlanCreate();
      allow update: if isPurchasingStaff() && validPrepPlanUpdate();
      allow delete: if false;
    }

    // ── purchaseDemandDrafts ─────────────────────────────────────────────────
    function validPurchaseDemandDraftCommon() {
      return request.resource.data.keys().hasOnly([
        'draftName', 'sourcePrepPlanId', 'sourcePrepPlanNameSnapshot',
        'status', 'items', 'isActive', 'workflowStatus', 'notes',
        'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
      ])
      && request.resource.data.draftName is string
      && request.resource.data.sourcePrepPlanId is string
      && request.resource.data.sourcePrepPlanNameSnapshot is string
      && request.resource.data.status in ['draft', 'archived']
      && request.resource.data.items is list
      && request.resource.data.isActive is bool
      && (!('workflowStatus' in request.resource.data.keys())
          || request.resource.data.workflowStatus in ['draft', 'exported', 'sent', 'completed', 'cancelled']);
    }

    function validPurchaseDemandDraftCreate() {
      return validPurchaseDemandDraftCommon()
        && request.resource.data.createdBy == request.auth.uid;
    }

    function validPurchaseDemandDraftUpdate() {
      return validPurchaseDemandDraftCommon()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.sourcePrepPlanId == resource.data.sourcePrepPlanId
        && request.resource.data.sourcePrepPlanNameSnapshot == resource.data.sourcePrepPlanNameSnapshot
        && request.resource.data.updatedBy == request.auth.uid;
    }

    match /purchaseDemandDrafts/{draftId} {
      allow read: if isAuthenticated();
      allow create: if isPurchasingStaff() && validPurchaseDemandDraftCreate();
      allow update: if isPurchasingStaff() && validPurchaseDemandDraftUpdate();
      allow delete: if false;
    }

    // ── productionWorkflowPlans ──────────────────────────────────────────────
    // 製程規劃表：由 /prepPlans 衍生的廚房作業規劃。已登入可讀；寫入需採購人員。
    // sourcePrepPlanId / sourcePrepPlanNameSnapshot / createdAt / createdBy 不可變更。
    // tasks 陣列不可硬刪除任務；由 service reconstruction + UI 行為執行。
    function validProductionWorkflowPlanCommon() {
      let data = request.resource.data;
      return data.keys().hasOnly([
        'sourcePrepPlanId', 'sourcePrepPlanNameSnapshot',
        'planName', 'serviceDate', 'status', 'isActive',
        'tasks', 'notes',
        'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
      ])
      && data.planName is string && data.planName.size() > 0
      && data.sourcePrepPlanId is string && data.sourcePrepPlanId.size() > 0
      && data.sourcePrepPlanNameSnapshot is string
      && data.status in ['draft', 'archived']
      && data.isActive is bool
      && data.tasks is list
      && data.updatedAt is timestamp
      && data.updatedBy is string;
    }

    function validProductionWorkflowPlanCreate() {
      let data = request.resource.data;
      return validProductionWorkflowPlanCommon()
        && data.createdAt is timestamp
        && data.createdBy is string
        && data.createdBy == request.auth.uid;
    }

    function validProductionWorkflowPlanUpdate() {
      return validProductionWorkflowPlanCommon()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.sourcePrepPlanId == resource.data.sourcePrepPlanId
        && request.resource.data.sourcePrepPlanNameSnapshot == resource.data.sourcePrepPlanNameSnapshot
        && request.resource.data.updatedBy == request.auth.uid;
    }

    match /productionWorkflowPlans/{planId} {
      allow read: if isAuthenticated();
      allow create: if isPurchasingStaff() && validProductionWorkflowPlanCreate();
      allow update: if isPurchasingStaff() && validProductionWorkflowPlanUpdate();
      allow delete: if false;
    }

    // ── capacityFeasibilityChecks ────────────────────────────────────────────
    // 產能可行性評估記錄：建立後不可修改/刪除（immutable）。
    // 已登入可讀；建立需採購人員。
    function validCapacityFeasibilityCheckCreate() {
      let data = request.resource.data;
      return data.keys().hasOnly([
        'sourceProductionWorkflowPlanId', 'sourceProductionWorkflowPlanNameSnapshot',
        'targetServiceDateTime', 'capacityWindowMinutes', 'bufferMinutes',
        'availableStaff', 'availableEquipment', 'result',
        'createdAt', 'createdBy'
      ])
      && data.sourceProductionWorkflowPlanId is string
      && data.sourceProductionWorkflowPlanId.size() > 0
      && data.sourceProductionWorkflowPlanNameSnapshot is string
      && data.targetServiceDateTime is timestamp
      && data.capacityWindowMinutes is number && data.capacityWindowMinutes > 0
      && data.bufferMinutes is number && data.bufferMinutes >= 0
      && data.availableStaff is list
      && data.availableEquipment is list
      && data.result is map
      && data.createdBy == request.auth.uid;
    }

    match /capacityFeasibilityChecks/{checkId} {
      allow read: if isAuthenticated();
      allow create: if isPurchasingStaff() && validCapacityFeasibilityCheckCreate();
      allow update: if false;
      allow delete: if false;
    }

    // ── menuMixRecommendations ───────────────────────────────────────────────
    // 菜單組合建議記錄：建立後不可修改/刪除（immutable）。
    // 已登入可讀；建立需採購人員。
    function validMenuMixRecommendationCreate() {
      let data = request.resource.data;
      return data.keys().hasOnly([
        'targetServingCount', 'targetServiceDateTime',
        'capacityWindowMinutes', 'bufferMinutes',
        'candidateRecipeIds', 'constraints',
        'availableStaff', 'availableEquipment',
        'recommendedMixItems', 'recommendationStatus', 'riskLevel',
        'estimatedProcessLoadSummary', 'estimatedEquipmentLoadRatios', 'estimatedStaffLoadRatios',
        'bottleneckWarnings', 'manualReviewNotes',
        'createdAt', 'createdBy'
      ])
      && data.targetServingCount is number && data.targetServingCount > 0
      && data.targetServiceDateTime is timestamp
      && data.capacityWindowMinutes is number && data.capacityWindowMinutes > 0
      && data.bufferMinutes is number && data.bufferMinutes >= 0
      && data.bufferMinutes < data.capacityWindowMinutes
      && data.candidateRecipeIds is list
      && data.constraints is map
      && data.availableStaff is list
      && data.availableEquipment is list
      && data.recommendedMixItems is list
      && data.recommendationStatus in ['feasible', 'risky', 'notRecommended']
      && data.riskLevel in ['low', 'medium', 'high']
      && data.estimatedProcessLoadSummary is map
      && data.estimatedEquipmentLoadRatios is map
      && data.estimatedStaffLoadRatios is map
      && data.bottleneckWarnings is list
      && data.manualReviewNotes is list
      && data.createdBy == request.auth.uid;
    }

    match /menuMixRecommendations/{recId} {
      allow read: if isAuthenticated();
      allow create: if isPurchasingStaff() && validMenuMixRecommendationCreate();
      allow update: if false;
      allow delete: if false;
    }

    // ── menuDrafts ───────────────────────────────────────────────────────────
    // 人工參考用草稿菜單：由 menuMixRecommendations 建立，建立後不可修改/刪除（immutable）。
    // 已登入可讀；建立需採購人員。非正式菜單，不會觸發任何下游自動化流程。
    function validMenuDraftCreate() {
      let data = request.resource.data;
      return data.keys().hasOnly([
        'sourceRecommendationId', 'sourceRecommendationCreatedAtSnapshot',
        'sourceRecommendationStatusSnapshot', 'menuName', 'items',
        'status', 'notes', 'manualReviewNotesSnapshot',
        'createdAt', 'createdBy'
      ])
      && data.sourceRecommendationId is string && data.sourceRecommendationId.size() > 0
      && (!('sourceRecommendationCreatedAtSnapshot' in data) || data.sourceRecommendationCreatedAtSnapshot is timestamp)
      && data.sourceRecommendationStatusSnapshot in ['feasible', 'risky', 'notRecommended']
      && data.menuName is string && data.menuName.size() > 0
      && data.items is list && data.items.size() > 0
      && data.status == 'draft'
      && (!('notes' in data) || data.notes is string)
      && data.manualReviewNotesSnapshot is list
      && data.createdAt is timestamp
      && data.createdBy == request.auth.uid;
    }

    match /menuDrafts/{draftId} {
      allow read: if isAuthenticated();
      allow create: if isPurchasingStaff() && validMenuDraftCreate();
      allow update: if false;
      allow delete: if false;
    }

    // ── Feature 023: 通用月菜單匯入暫存 ────────────────────────────────────────

    function importBatchAllowedFields() {
      return ['sourceFileName', 'organizationName', 'yearMonth', 'mealProgram',
        'servingBaseline', 'columnMappingTemplateId', 'columnMapping', 'importStatus',
        'rowCount', 'itemCount', 'reviewedItemCount', 'createdAt', 'createdBy',
        'updatedAt', 'updatedBy', 'finalizedAt', 'finalizedBy', 'archivedAt', 'archivedBy', 'notes',
        // Feature 027: additive duplicate-protection / import-summary fields.
        'contentFingerprint', 'skippedRowCount', 'warningCount', 'serviceDayCount',
        'duplicateOfBatchId', 'duplicateConfirmedAt', 'duplicateConfirmedBy',
        // Feature 028: additive operational-finalization tracking fields.
        'operationalFinalizedAt', 'operationalFinalizedBy'];
    }

    function validImportBatchCommon(data) {
      return data.sourceFileName is string && data.organizationName is string
        && data.yearMonth is string && data.mealProgram is string
        && data.servingBaseline is number && data.servingBaseline > 0
        && data.columnMapping is map
        && data.importStatus in ['draft', 'mappingApplied', 'parsed', 'reviewing', 'finalized', 'archived']
        && (!('contentFingerprint' in data) || data.contentFingerprint is string)
        && (!('skippedRowCount' in data) || data.skippedRowCount is number)
        && (!('warningCount' in data) || data.warningCount is number)
        && (!('serviceDayCount' in data) || data.serviceDayCount is number)
        && (!('duplicateOfBatchId' in data) || data.duplicateOfBatchId is string)
        && (!('duplicateConfirmedAt' in data) || data.duplicateConfirmedAt is timestamp)
        && (!('duplicateConfirmedBy' in data) || data.duplicateConfirmedBy is string)
        && (!('operationalFinalizedAt' in data) || data.operationalFinalizedAt is timestamp)
        && (!('operationalFinalizedBy' in data) || data.operationalFinalizedBy is string);
    }

    function validImportBatchCreate() {
      return validImportBatchCommon(request.resource.data)
        && request.resource.data.keys().hasOnly(importBatchAllowedFields())
        && request.resource.data.importStatus == 'draft'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.rowCount == 0
        && request.resource.data.itemCount == 0
        && request.resource.data.reviewedItemCount == 0
        // Feature 027: duplicateOfBatchId is only settable alongside both confirmation audit fields.
        && (!('duplicateOfBatchId' in request.resource.data)
            || (request.resource.data.duplicateConfirmedAt is timestamp
                && request.resource.data.duplicateConfirmedBy == request.auth.uid));
    }

    // Explicit transition whitelist — 'finalized'/'archived' are never reachable
    // through this function; only validImportBatchFinalize/Archive can set them.
    function validImportBatchUpdate() {
      return validImportBatchCommon(request.resource.data)
        && request.resource.data.keys().hasOnly(importBatchAllowedFields())
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy == request.auth.uid
        // Feature 027: content fingerprint and duplicate-confirmation audit fields are
        // immutable once a batch is created — never re-writable via plain update.
        && (('contentFingerprint' in resource.data) == ('contentFingerprint' in request.resource.data))
        && (!('contentFingerprint' in resource.data) || request.resource.data.contentFingerprint == resource.data.contentFingerprint)
        && (('duplicateOfBatchId' in resource.data) == ('duplicateOfBatchId' in request.resource.data))
        && (!('duplicateOfBatchId' in resource.data) || request.resource.data.duplicateOfBatchId == resource.data.duplicateOfBatchId)
        && (!('duplicateConfirmedAt' in resource.data) || request.resource.data.duplicateConfirmedAt == resource.data.duplicateConfirmedAt)
        && (!('duplicateConfirmedBy' in resource.data) || request.resource.data.duplicateConfirmedBy == resource.data.duplicateConfirmedBy)
        // Feature 028: operational-finalization fields are immutable once set —
        // never re-writable via plain update; only validImportBatchOperationalFinalize can set them.
        && (('operationalFinalizedAt' in resource.data) == ('operationalFinalizedAt' in request.resource.data))
        && (!('operationalFinalizedAt' in resource.data) || request.resource.data.operationalFinalizedAt == resource.data.operationalFinalizedAt)
        && (!('operationalFinalizedBy' in resource.data) || request.resource.data.operationalFinalizedBy == resource.data.operationalFinalizedBy)
        && (
          (resource.data.importStatus == 'draft' && request.resource.data.importStatus in ['draft', 'mappingApplied'])
          || (resource.data.importStatus == 'mappingApplied' && request.resource.data.importStatus in ['mappingApplied', 'parsed'])
          || (resource.data.importStatus == 'parsed' && request.resource.data.importStatus in ['parsed', 'reviewing'])
          || (resource.data.importStatus == 'reviewing' && request.resource.data.importStatus == 'reviewing')
        );
    }

    function validImportBatchFinalize() {
      return resource.data.importStatus == 'reviewing'
        && request.resource.data.importStatus == 'finalized'
        && request.resource.data.finalizedAt is timestamp
        && request.resource.data.finalizedBy == request.auth.uid
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['importStatus', 'finalizedAt', 'finalizedBy', 'updatedAt', 'updatedBy']);
    }

    function validImportBatchArchive() {
      return resource.data.importStatus == 'finalized'
        && request.resource.data.importStatus == 'archived'
        && request.resource.data.archivedAt is timestamp
        && request.resource.data.archivedBy == request.auth.uid
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['importStatus', 'archivedAt', 'archivedBy', 'updatedAt', 'updatedBy']);
    }

    // Feature 028: marks a 'finalized' batch as converted into operational
    // /recipeMenus docs. Settable only once — never reachable through
    // validImportBatchUpdate, and the diff is restricted to exactly these keys.
    function validImportBatchOperationalFinalize() {
      return resource.data.importStatus == 'finalized'
        && request.resource.data.importStatus == 'finalized'
        && !('operationalFinalizedAt' in resource.data)
        && request.resource.data.operationalFinalizedAt is timestamp
        && request.resource.data.operationalFinalizedBy == request.auth.uid
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['operationalFinalizedAt', 'operationalFinalizedBy', 'updatedAt', 'updatedBy']);
    }

    match /menuImportBatches/{batchId} {
      allow read: if isAuthenticated();
      allow create: if isPurchasingStaff() && validImportBatchCreate();
      allow update: if isPurchasingStaff()
        && (validImportBatchUpdate() || validImportBatchFinalize() || validImportBatchArchive() || validImportBatchOperationalFinalize());
      allow delete: if false;

      match /rows/{rowId} {
        allow read: if isAuthenticated();
        allow create: if isPurchasingStaff()
          && get(/databases/$(database)/documents/menuImportBatches/$(batchId)).data.importStatus in ['draft', 'mappingApplied']
          && request.resource.data.keys().hasOnly(['batchId', 'rowIndex', 'rawRowSnapshot', 'parsedDate', 'parsedMealType', 'createdAt', 'createdBy'])
          && request.resource.data.batchId == batchId
          && request.resource.data.rawRowSnapshot is map
          && request.resource.data.createdAt is timestamp
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if false;
        allow delete: if false;
      }

      match /items/{itemId} {
        allow read: if isAuthenticated();
        allow create: if isPurchasingStaff()
          && get(/databases/$(database)/documents/menuImportBatches/$(batchId)).data.importStatus in ['draft', 'mappingApplied']
          && request.resource.data.keys().hasOnly(['batchId', 'rowId', 'rowIndex', 'columnKey', 'rawDishName',
               'normalizedDishName', 'date', 'mealType', 'slot', 'reviewStatus', 'matchStatus', 'notes',
               'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && request.resource.data.batchId == batchId
          && request.resource.data.rawDishName is string
          && request.resource.data.matchStatus == 'unmatched'
          && request.resource.data.createdAt is timestamp
          && request.resource.data.createdBy == request.auth.uid;
        // Feature 024: additive matching fields + matchStatus lifecycle.
        // matchStatus transitions are restricted to itemMatchStatusTransition();
        // raw import fields (rawDishName/date/mealType/batchId/rowId/rowIndex/
        // columnKey/createdAt/createdBy) remain immutable per Section 7A.3.
        function itemMatchStatusTransition() {
          let from = resource.data.matchStatus;
          let to = request.resource.data.matchStatus;
          return (from == 'unmatched' && to in ['unmatched', 'mapped', 'pending_review', 'unresolved'])
            || (from == 'pending_review' && to in ['pending_review', 'mapped', 'rejected', 'unresolved'])
            || (from == 'unresolved' && to in ['unresolved', 'pending_review', 'mapped'])
            || (from == 'mapped' && to == 'mapped');
        }
        function itemMatchedRecipeIdValid() {
          return request.resource.data.matchStatus != 'mapped'
            || (request.resource.data.matchedRecipeId is string && request.resource.data.matchedRecipeId.size() > 0);
        }
        allow update: if isPurchasingStaff()
          && get(/databases/$(database)/documents/menuImportBatches/$(batchId)).data.importStatus in ['parsed', 'reviewing']
          && request.resource.data.keys().hasOnly(['batchId', 'rowId', 'rowIndex', 'columnKey', 'rawDishName',
               'normalizedDishName', 'date', 'mealType', 'slot', 'reviewStatus', 'matchStatus', 'notes',
               'createdAt', 'createdBy', 'updatedAt', 'updatedBy',
               'matchedRecipeId', 'candidateId', 'matchConfidence', 'matchSource', 'matchingError'])
          && request.resource.data.rawDishName == resource.data.rawDishName
          && request.resource.data.date == resource.data.date
          && request.resource.data.mealType == resource.data.mealType
          && request.resource.data.batchId == resource.data.batchId
          && request.resource.data.rowId == resource.data.rowId
          && request.resource.data.rowIndex == resource.data.rowIndex
          && request.resource.data.columnKey == resource.data.columnKey
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy
          && resource.data.matchStatus != 'rejected'
          && itemMatchStatusTransition()
          && itemMatchedRecipeIdValid()
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.updatedBy == request.auth.uid;
        allow delete: if false;
      }
    }

    // ── Feature 024: 菜名比對與推定配方建立 (staging-only) ──────────────────
    // Reality-aligned: no org/tenant claim exists in this app (see
    // docs/features/feature-024/SSOT_RECONCILIATION_PACKAGE.md Section 7A).
    // Gated by the same isPurchasingStaff() role check used by Feature 023.
    // Never grants write access to recipes/ingredients/recipeIngredients.

    function validProposedRecipeCandidateCommon(data) {
      return data.sourceItemId is string && data.sourceItemId.size() > 0
        && data.sourceBatchId is string && data.sourceBatchId.size() > 0
        && data.rawDishNameSnapshot is string
        && data.ingredients is list
        && data.status in ['pending', 'confirmed', 'rejected'];
    }

    function candidateAllowedFields() {
      return ['sourceItemId', 'sourceBatchId', 'rawDishNameSnapshot', 'ingredients',
        'status', 'notes', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'];
    }

    match /proposedRecipeCandidates/{candidateId} {
      allow read: if isAuthenticated();
      allow create: if isPurchasingStaff()
        && validProposedRecipeCandidateCommon(request.resource.data)
        && request.resource.data.keys().hasOnly(candidateAllowedFields())
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy == request.auth.uid;
      // Confirmation/rejection is a human-review status change only — it
      // never creates formal recipes/ingredients/recipeIngredients (enforced
      // by application code; this rule only allows the staging status flip).
      allow update: if isPurchasingStaff()
        && validProposedRecipeCandidateCommon(request.resource.data)
        && request.resource.data.keys().hasOnly(candidateAllowedFields())
        && request.resource.data.sourceItemId == resource.data.sourceItemId
        && request.resource.data.sourceBatchId == resource.data.sourceBatchId
        && request.resource.data.rawDishNameSnapshot == resource.data.rawDishNameSnapshot
        && request.resource.data.ingredients == resource.data.ingredients
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && resource.data.status == 'pending'
        && request.resource.data.status in ['confirmed', 'rejected']
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    function validRecipeAliasCommon(data) {
      return data.rawAlias is string && data.rawAlias.size() > 0
        && data.normalizedAlias is string && data.normalizedAlias.size() > 0
        && data.recipeId is string && data.recipeId.size() > 0
        && data.status in ['pending', 'confirmed', 'rejected'];
    }

    function aliasAllowedFields() {
      return ['rawAlias', 'normalizedAlias', 'recipeId', 'status', 'notes',
        'createdAt', 'createdBy', 'updatedAt', 'updatedBy'];
    }

    match /recipeAliases/{aliasId} {
      allow read: if isAuthenticated();
      allow create: if isPurchasingStaff()
        && validRecipeAliasCommon(request.resource.data)
        && request.resource.data.keys().hasOnly(aliasAllowedFields())
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy == request.auth.uid;
      // confirmed is immutable on core fields; rejected is final.
      allow update: if isPurchasingStaff()
        && validRecipeAliasCommon(request.resource.data)
        && request.resource.data.keys().hasOnly(aliasAllowedFields())
        && request.resource.data.rawAlias == resource.data.rawAlias
        && request.resource.data.normalizedAlias == resource.data.normalizedAlias
        && request.resource.data.recipeId == resource.data.recipeId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && resource.data.status == 'pending'
        && request.resource.data.status in ['confirmed', 'rejected']
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    match /menuImportColumnMappingTemplates/{templateId} {
      allow read: if isAuthenticated();
      allow create, update: if isPurchasingStaff()
        && request.resource.data.keys().hasOnly(['templateName', 'organizationName', 'mealProgram',
             'sourceFormat', 'columnMappings', 'defaultMealType', 'defaultServingBaseline', 'isActive',
             'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && request.resource.data.sourceFormat == 'csv'
        && request.resource.data.columnMappings is map
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    // ── Feature 032: 果菜市場市價整合 (marketPrices) ────────────────────────
    // 共用每日行情快取，doc ID = ISO 日期 "YYYY-MM-DD"。任何已登入員工皆可
    // 觸發重新整理（非個人資料，是全店共用的快取，故不限採購人員角色）。
    // 不可刪除；不可修改 date/rocDate（快取鍵值意義的欄位）。
    function validMarketPriceCommon(data) {
      return data.keys().hasOnly(['date', 'rocDate', 'entries', 'warnings', 'fetchedAt', 'fetchedBy'])
        && data.date is string && data.date.size() > 0
        && data.rocDate is string && data.rocDate.size() > 0
        && data.entries is list
        && data.warnings is list
        && data.fetchedAt is timestamp
        && data.fetchedBy is string;
    }

    function validMarketPriceCreate() {
      return validMarketPriceCommon(request.resource.data)
        && request.resource.data.fetchedBy == request.auth.uid;
    }

    function validMarketPriceUpdate() {
      return validMarketPriceCommon(request.resource.data)
        && request.resource.data.date == resource.data.date
        && request.resource.data.fetchedBy == request.auth.uid;
    }

    match /marketPrices/{date} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && validMarketPriceCreate();
      allow update: if isAuthenticated() && validMarketPriceUpdate();
      allow delete: if false;
    }

    // ── costAwareMenuSuggestions ─────────────────────────────────────────────
    // 性價比菜單建議記錄：建立後不可修改/刪除（immutable）。
    // 已登入可讀；建立需採購人員。人工參考用，不會自動建立菜單或採購。
    function validCostAwareMenuSuggestionCreate() {
      let data = request.resource.data;
      return data.keys().hasOnly([
        'targetServingCount', 'priceSnapshotDate', 'assessedRecipeCount',
        'items', 'manualReviewNotes',
        'createdAt', 'createdBy'
      ])
      && data.targetServingCount is number && data.targetServingCount > 0
      && (data.priceSnapshotDate == null || data.priceSnapshotDate is string)
      && data.assessedRecipeCount is number && data.assessedRecipeCount >= 0
      && data.items is list
      && data.manualReviewNotes is list
      && data.createdBy == request.auth.uid;
    }

    match /costAwareMenuSuggestions/{id} {
      allow read: if isAuthenticated();
      allow create: if isPurchasingStaff() && validCostAwareMenuSuggestionCreate();
      allow update: if false;
      allow delete: if false;
    }

    // ── productionScheduleSuggestions ────────────────────────────────────────
    // 生產排程建議記錄：建立後不可修改/刪除（immutable）。
    // 已登入可讀；建立需採購人員。人工參考用，不會回寫製程規劃。
    function validProductionScheduleSuggestionCreate() {
      let data = request.resource.data;
      return data.keys().hasOnly([
        'sourceProductionWorkflowPlanId', 'sourcePlanNameSnapshot',
        'targetServiceDateTime', 'capacityWindowMinutes', 'bufferMinutes',
        'availableStaff', 'availableEquipment',
        'scheduledTasks', 'makespanMinutes', 'scheduleStatus',
        'unschedulableTaskIds', 'staffUtilization', 'equipmentUtilization',
        'workStartSuggestion', 'manualReviewNotes',
        'createdAt', 'createdBy'
      ])
      && data.sourceProductionWorkflowPlanId is string
      && data.sourceProductionWorkflowPlanId.size() > 0
      && data.sourcePlanNameSnapshot is string
      && data.targetServiceDateTime is timestamp
      && data.capacityWindowMinutes is number && data.capacityWindowMinutes > 0
      && data.bufferMinutes is number && data.bufferMinutes >= 0
      && data.availableStaff is list
      && data.availableEquipment is list
      && data.scheduledTasks is list
      && data.makespanMinutes is number && data.makespanMinutes >= 0
      && data.scheduleStatus in ['fits', 'overrun', 'infeasible']
      && data.unschedulableTaskIds is list
      && data.staffUtilization is map
      && data.equipmentUtilization is map
      && data.workStartSuggestion is string
      && data.manualReviewNotes is list
      && data.createdBy == request.auth.uid;
    }

    match /productionScheduleSuggestions/{id} {
      allow read: if isAuthenticated();
      allow create: if isPurchasingStaff() && validProductionScheduleSuggestionCreate();
      allow update: if false;
      allow delete: if false;
    }

    // ── 其他所有路徑：預設拒絕 ────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
